 "dudas": [
  {
   "pregunta": "¿Se deja afuera de la carga el cuadro 'Niteliklerine göre giderler' (nota 21, L1934-L1953) por ser una reclasificación por naturaleza de los mismos gastos ya desglosados en las notas 19 y 20?",
   "propuesta": "sí",
   "tema": "cuadro-duplicado",
   "renglon": "",
   "texto": "El cuadro L1934-L1953 reagrupa costo de ventas, comercialización y administración (total 1.369.886.873, que difiere en 102.600 de la suma 1.369.784.273 de esos tres renglones del estado), cargarlo duplicaría gastos.",
   "bloques": [
    "b60",
    "b57",
    "b58",
    "b59"
   ],
   "afecta_carga": true
  },
  {
   "pregunta": "¿Se deja sin cargar como filas el desglose en texto de la nota (*) de 'Esas faaliyetlerden diğer gelirler (*)' (L1974: 89.621.202 TL y 45.328.336 TL)?",
   "propuesta": "sí",
   "tema": "otro",
   "renglon": "Esas faaliyetlerden diğer gelirler (*)",
   "texto": "L1974 es una nota al pie en prosa, no una tabla; sus importes ya están dentro de 136.626.350 de L1971.",
   "bloques": [
