 "dudas": [
  {
   "pregunta": "¿Se usa la columna Total del cuadro por segmento (b44/b45) para abrir 'Ingresos de actividades ordinarias' en ANFP, TV, borderó, venta/préstamo de jugadores, publicidad, socios, etc.?",
   "propuesta": "sí",
   "tema": "usar-cuadro-por-segmento",
   "renglon": "Ingresos de actividades ordinarias",
   "texto": "La nota 19 (b39) solo separa recaudaciones y comerciales; el cuadro por segmento abre el detalle por concepto que no aparece en otra nota.",
   "bloques": [
    "b44",
    "b45",
    "b39"
   ],
   "afecta_carga": true
  },
  {
   "pregunta": "¿Se carga el costo de ventas desde la nota 20 (b41) y no desde la sección de costos del cuadro por segmento (b44), que repite los mismos conceptos?",
   "propuesta": "sí",
   "tema": "cuadro-duplicado",
   "renglon": "Costo de ventas",
   "texto": "Ambos cuadros abren el costo de ventas con los mismos renglones; evitar doble carga.",
   "bloques": [
    "b41",
    "b44"
   ],
   "afecta_carga": true
  }
 ],
 "observaciones": "Estado de resultados por función individual de Cruzados SADP en b4 (pág. 5), M$. b39/b40 nota de ingresos ordinarios (2012/2011); b41/b42 costo de ventas (2012/2011); b44-b45 información por segmento (Fútbol / Comercial / Total). El segmento incluye impuestos a las ganancias dentro de otros ingresos; tomar solo renglones de ingresos/gastos operativos. Se excluyen balance, flujo, patrimonio, intangibles, detalle por jugador (b20-b21) y conciliación tributaria."
