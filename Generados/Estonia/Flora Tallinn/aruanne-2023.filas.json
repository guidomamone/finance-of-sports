 "dudas": [
  {
   "pregunta": "¿Se deja afuera de la carga el cuadro 'Rahalised ja mitterahalised annetused' (L729-L731) por ser un desglose alternativo del mismo renglón ya desglosado en Lisa 12?",
   "propuesta": "sí",
   "tema": "cuadro-duplicado",
   "renglon": "Annetused ja toetused",
   "texto": "El cuadro b28 (L729-L731) reparte el mismo total 2 054 090 por naturaleza monetaria/no monetaria, duplicando el desglose de L717-L723.",
   "bloques": [
    "b28",
    "b27"
   ],
   "afecta_carga": true
