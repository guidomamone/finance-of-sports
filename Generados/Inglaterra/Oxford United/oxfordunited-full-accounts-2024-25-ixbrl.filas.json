 "dudas": [
  {
   "pregunta": "¿Se dejan afuera de la carga las filas de remuneración de la nota 6 (L512-L515: Wages and salaries 19,033,235 etc.), ya que no desglosan un único renglón del estado sino que se reparten entre Cost of sales y Administrative expenses?",
   "propuesta": "sí",
   "tema": "perimetro",
   "renglon": "",
   "texto": "La nota 6 (L509-L515) informa gastos de personal sin indicar a qué renglón del estado corresponden; no hay filas de 'Salarios del plantel' ni 'Cuotas sociales' en el documento.",
   "bloques": [
    "b33"
   ],
   "afecta_carga": true
  },
  {
   "pregunta": "¿Se deja afuera de la carga el cuadro 'Operating loss is stated after charging' (L483-L489)?",
   "propuesta": "sí",
   "tema": "perimetro",
   "renglon": "Operating loss",
   "texto": "L483-L489 son partidas informativas incluidas en distintos renglones, no un desglose aditivo del resultado operativo.",
   "bloques": [
    "b31"
   ],
   "afecta_carga": true
  }
 ],
 "observaciones": "No existen en el documento renglones 'Salarios del plantel' ni 'Cuotas sociales'; los ingresos de socios estarían en Gate receipts. Columna 2024 es 'as restated'. Other operating income (nota 4) no tiene desglose numérico."
}