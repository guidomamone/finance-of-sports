 "dudas": [
  {
   "pregunta": "¿Se dejan afuera de la carga las filas L1188-L1191 de la nota b11 (reversión de deterioro, venta de jugadores, diferencias de cambio, alquileres) por no desglosar un único renglón del estado?",
   "propuesta": "sí",
   "tema": "otro",
   "renglon": "",
   "texto": "La nota b11 es un listado de cargos incluidos en el resultado operativo de distintos renglones (L1188-L1191: venta de jugadores ya está en L662; los demás estarían dentro de Other operating expenses), no un desglose sumable.",
   "bloques": [
    "b11"
   ],
   "afecta_carga": true
  }
 ],
 "observaciones": "Escala en miles de libras (£000) en todos los bloques. El estado no imprime total de ingresos ni de gastos. Depreciation (1,484) + Amortisation (41,226) = 42,710 coincide con L664, por eso se asignan a ese renglón. Las notas 5, 6 y 7 de otros ingresos no están en los bloques."
}