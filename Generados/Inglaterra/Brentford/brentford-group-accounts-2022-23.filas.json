 "dudas": [
  {
   "pregunta": "¿Se cargan los renglones de b19 (L1672-L1679) como desglose de 'Administrative expenses' aunque sean partidas informativas que no suman el renglón?",
   "propuesta": "sí",
   "tema": "otro",
   "renglon": "Administrative expenses",
   "texto": "La nota 5 (L1668) lista cargos incluidos en el resultado operativo sin total, y diferencias de cambio podrían no estar en gastos administrativos.",
   "bloques": [
    "b19"
   ],
   "afecta_carga": true
  },
  {
   "pregunta": "¿Se acepta que no existe un renglón 'Salarios del plantel' separado y que 'Wages and salaries' (L1636) es el salario total del personal?",
   "propuesta": "sí",
   "tema": "otro",
   "renglon": "Administrative expenses",
   "texto": "La nota 4 (L1636) no separa jugadores del resto del personal; no hay fila específica de plantel en los bloques.",
   "bloques": [
    "b17"
   ],
   "afecta_carga": false
  }
 ],
 "observaciones": "Sin cuadros por segmento. 'Salarios del plantel' no figura como tal; la masa salarial está en nota 4 (b17, L1636-L1639: 98,800), incluida en Administrative expenses. No se imprimen totales de ingresos ni de gastos."
