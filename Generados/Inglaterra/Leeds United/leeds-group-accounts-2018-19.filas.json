 "dudas": [
  {
   "pregunta": "¿Se cargan los costos de personal de la nota 7 (L833-L836) como desglose de 'Administrative expenses', aunque el documento no indica si parte está en 'Cost of sales'?",
   "propuesta": "sí",
   "tema": "otro",
   "renglon": "Administrative expenses",
   "texto": "La nota 7 (L831) no asigna los payroll costs a un renglón del estado; 'Wages and salaries' (L833) es la fila de salarios, que incluye plantel y resto del personal sin separarlo.",
   "bloques": [
    "b11",
    "b2"
   ],
   "afecta_carga": true
  },
  {
   "pregunta": "¿Se deja afuera de la carga el cuadro de cargos operativos de la nota 5 (L789-L796)?",
   "propuesta": "sí",
   "tema": "otro",
   "renglon": "Operating loss",
   "texto": "Son partidas informativas cargadas en el resultado operativo (amortización, depreciación, etc.) que no desglosan un renglón concreto ni suman a un total del estado.",
   "bloques": [
    "b9"
   ],
   "afecta_carga": true
  }
 ],
 "observaciones": "Todas las cifras en libras (unidades). No hay renglón separado de 'Salarios del plantel'; el único dato de salarios es 'Wages and salaries' (L833) en la nota 7, que no distingue plantel de otro personal. No hay total de gastos impreso."
