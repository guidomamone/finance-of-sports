 "dudas": [
  {
   "pregunta": "¿Se deja afuera de la carga el cuadro de b30 (L1118-L1123), ya que mezcla 'Demais Receitas' con el importe de 'OUTRAS RECEITAS/(DESPESAS)' y no cuadra con el estado?",
   "propuesta": "sí",
   "tema": "otro",
   "renglon": "DEMAIS RECEITAS",
   "texto": "L1121 da 20.805.324 como Demais Receitas, que es el importe de OUTRAS RECEITAS/(DESPESAS) (L221), no el de DEMAIS RECEITAS (7.167.435, L194); el total L1123 no coincide con ningún renglón del estado.",
   "bloques": [
    "b30",
    "b6"
   ],
   "afecta_carga": true
  },
  {
   "pregunta": "¿Es correcto que en el estado RECEITA OPERACIONAL BRUTA (36.625.176) es igual a Receita Futebol Profissional + Demais Receitas, y que la nota L1120 la rotula como 'Receita Futebol Profissional'?",
   "propuesta": "sí",
   "tema": "otro",
   "renglon": "RECEITA FUTEBOL PROFISSIONAL",
   "texto": "L1120 asigna 36.625.175 (bruta total, diferencia de 1 por redondeo) a Receita Futebol Profissional, cuando el estado muestra 29.457.740 (L187).",
   "bloques": [
    "b30",
    "b6"
   ],
   "afecta_carga": false
  },
  {
   "pregunta": "¿Se trata 'OUTRAS RECEITAS/(DESPESAS)' (L221, 20.805.324 positivo) como ingreso no operativo y no como gasto?",
   "propuesta": "sí",
   "tema": "otro",
   "renglon": "OUTRAS RECEITAS/(DESPESAS)",
   "texto": "El encabezado L219 '(+/-) DESPESAS/(RECEITAS)' es ambiguo en signo, pero el resultado L222 (-60.936.997+18.788.324) indica que suma como ingreso.",
