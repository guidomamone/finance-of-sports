   "afecta_carga": true
  },
  {
   "pregunta": "¿Se dejan afuera las filas L3289-L3291 y el Total L3301 de b61, que repiten los renglones a), b), c) de 14) del estado?",
   "propuesta": "sí",
   "tema": "cuadro-duplicado",
   "renglon": "d) Others",
