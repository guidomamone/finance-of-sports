   ],
   "afecta_carga": true
  },
  {
   "pregunta": "¿Se deja afuera el cuadro de personal por columnas b58 (L3226-L3230), ya que sus totales repiten los renglones 9) del estado?",
   "propuesta": "sí",
   "tema": "cuadro-duplicado",
