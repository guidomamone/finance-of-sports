  {
   "pregunta": "¿Se deja afuera de la carga el renglón 'Incrementi di immobilizzazione per lavori interni e capitalizzazione costi vivaio' (L888) por no tener importe 2021?",
   "propuesta": "sí",
   "tema": "fila-ilegible",
   "renglon": "Incrementi di immobilizzazione per lavori interni e capitalizzazione costi vivaio",
   "texto": "L888 solo muestra 1.779.291 en 2020; el total 2021 (76.310.004 = 1.015.668 + 75.294.336) confirma que 2021 es cero.",
   "bloques": [
    "b28"
   ],
   "afecta_carga": false
