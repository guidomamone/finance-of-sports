 "dudas": [
  {
   "pregunta": "¿Se toma la nota b52 (L3201-L3211) como desglose del renglón 'Totale altri ricavi e proventi' incluyendo 'Contributi in conto esercizio'?",
   "propuesta": "sí",
   "tema": "otro",
   "renglon": "Totale altri ricavi e proventi",
