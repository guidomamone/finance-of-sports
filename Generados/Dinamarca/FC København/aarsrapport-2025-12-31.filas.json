 "dudas": [
  {
   "pregunta": "¿Se deja afuera de la carga la nota 8 'Forslag til resultatdisponering' (L404-L408), por ser distribución del resultado y no ingresos/gastos?",
   "propuesta": "sí",
   "tema": "perimetro",
   "renglon": "Årets resultat",
   "texto": "La nota 8 (L404-L408) reparte el resultado en dividendo y resultado transferido; no desglosa ingresos ni gastos.",
   "bloques": [
    "b22"
   ],
   "afecta_carga": false
  }
 ],
 "observaciones": "Escala t.kr. (miles de DKK) en estado y notas. No se imprimen totales de ingresos ni de gastos. 'Resultat før skat' igual a 'Årets resultat' (sin impuesto, sociedad P/S transparente). Fila L373 (número medio de empleados) no se extrae por no ser importe monetario. 'Indtægter af kapitalandele i tilknyttede virksomheder' clasificado como otro."
}