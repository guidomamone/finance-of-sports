{
  "permissions": {
    "allow": [
      "Read(//Users/guidopablomamonesoneira/Claude/Projects/finance-of-sports/Clubes/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Agent|Task|EnterPlanMode|mcp__ccd_session_mgmt__archive_session|mcp__ccd_session__start_session|mcp__ccd_session_mgmt__set_session_model",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/hooks/pre-tool.mjs\"; [ ! -f \"$f\" ] || node \"$f\"",
            "timeout": 120,
            "statusMessage": "Chequeando las reglas del proyecto (tools/hooks/pre-tool.mjs)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/hooks/post-tool.mjs\"; [ ! -f \"$f\" ] || node \"$f\"",
            "timeout": 30,
            "statusMessage": "Chequeando si el commit cambia una skill (tools/hooks/post-tool.mjs)"
          }
        ]
      }
    ]
  }
}
