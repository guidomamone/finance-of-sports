{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financeofsports.com/data/schema/club-v2.json",
  "title": "Finance of Sports: datos de un club (schema_version 2.0)",
  "description": "Un archivo por club. Importes en millones de la moneda del club (unit.scale); gastos en negativo. Cada línea lleva category (genérica, la misma para cualquier deporte) y subcategory (la del deporte); el mapa de cada deporte está en data/schema/taxonomy-<club.taxonomy>.json. Se genera con tools/generar-schema-json.mjs; el diccionario de campos: Admin/mediciones/245-esquema.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "exported_at": {
      "$ref": "#/$defs/fecha"
    },
    "unit": {
      "type": "object",
      "properties": {
        "scale": {
          "const": 1000000
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "scale",
        "label"
      ],
      "additionalProperties": false
    },
    "club": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "reporting_currency": {
          "$ref": "#/$defs/moneda"
        },
        "fiscal_year_start": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}$"
        },
        "predecessor_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "sport": {
          "enum": [
            "football",
            "basketball",
            "rugby_union",
            "american_football",
            "formula_1",
            "tennis",
            "cricket",
            "other"
          ]
        },
        "taxonomy": {
          "enum": [
            "football-1",
            "rugby-1"
          ]
        }
      },
      "required": [
        "id",
        "taxonomy"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fuente"
      }
    },
    "management": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "first_year": {
            "type": "integer"
          },
          "last_year": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "first_year",
          "last_year"
        ],
        "additionalProperties": false
      }
    },
    "members": {
      "type": [
        "number",
        "null"
      ]
    },
    "years": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anio"
      }
    },
    "budget_overlay": {
      "type": "object",
      "patternProperties": {
        "^\\d{4}$": {
          "$ref": "#/$defs/overlay"
        }
      },
      "additionalProperties": false
    },
    "squad_transfers": {
      "type": "array",
      "description": "Opcional: no va en el paquete publicado (solo lo financiero)."
    },
    "results": {
      "type": "object"
    },
    "titles": {
      "type": "array"
    },
    "extras": {
      "type": "object",
      "properties": {
        "budget_assumptions": {},
        "budget_financial": {},
        "budget_investments": {},
        "finance_years": {},
        "finance_managements": {}
      },
      "required": [],
      "additionalProperties": false,
      "description": "Contenido editorial de pocos clubes (supuestos y detalle del presupuesto, ejercicios y gestiones a mostrar): las claves van en inglés y los textos quedan en español."
    }
  },
  "required": [
    "schema_version",
    "exported_at",
    "unit",
    "club",
    "sources",
    "years"
  ],
  "additionalProperties": false,
  "$defs": {
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "moneda": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217"
    },
    "fuente": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "club_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "reliability": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "public_note": {
          "type": "string"
        },
        "document": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "club_id",
        "title",
        "type",
        "reliability"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "description": "Desglose de una línea: [rótulo, importe] o [rótulo, importe, subitems]."
    },
    "item": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": false
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/items"
            }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        }
      ]
    },
    "linea_ingreso": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "category": {
          "enum": [
            "membership",
            "matchday",
            "season_tickets",
            "venue",
            "media_rights",
            "prize_money",
            "commercial",
            "player_transfers",
            "other_sporting_sections",
            "non_sporting_activities",
            "grants_donations",
            "other_revenue",
            "undisclosed"
          ]
        },
        "subcategory": {
          "enum": [
            "academy_community",
            "academy_community_expense",
            "admin_general_expense",
            "broadcasting",
            "central_income",
            "commercial_activities",
            "competition_bonus",
            "depreciation",
            "education",
            "education_expense",
            "exceptional_items",
            "gate_receipts",
            "grants_donations",
            "lump_football_operations",
            "lump_football_operations_expense",
            "lump_rugby_operations",
            "lump_rugby_operations_expense",
            "match_organisation_expense",
            "matchday_competition",
            "matchday_costs",
            "member_dues",
            "other_amortisation",
            "other_expenses",
            "other_income",
            "other_sports",
            "player_amortisation",
            "player_impairment",
            "player_registrations_amortisation",
            "player_sales",
            "player_transfers",
            "season_tickets",
            "sponsorship_commercial",
            "squad_wages",
            "stadium_other",
            "wages_squad",
            "womens_football",
            "youth_football",
            "youth_other_sports_expense"
          ]
        },
        "amount": {
          "type": "number"
        },
        "disclosure": {
          "enum": [
            "aggregate",
            "aggregated",
            "aggregated_residual",
            "detailed",
            "estimated",
            "lump",
            "not_disclosed",
            "partial",
            "summary"
          ]
        },
        "items": {
          "$ref": "#/$defs/items"
        }
      },
      "required": [
        "label",
        "category",
        "subcategory",
        "amount"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "category": {
              "const": "membership"
            },
            "subcategory": {
              "enum": [
                "member_dues"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "matchday"
            },
            "subcategory": {
              "enum": [
                "gate_receipts",
                "matchday_competition"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "season_tickets"
            },
            "subcategory": {
              "enum": [
                "season_tickets"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "venue"
            },
            "subcategory": {
              "enum": [
                "stadium_other"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "media_rights"
            },
            "subcategory": {
              "enum": [
                "broadcasting",
                "central_income"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "prize_money"
            },
            "subcategory": {
              "enum": [
                "competition_bonus"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "commercial"
            },
            "subcategory": {
              "enum": [
                "commercial_activities",
                "sponsorship_commercial"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "player_transfers"
            },
            "subcategory": {
              "enum": [
                "player_sales",
                "player_transfers"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "other_sporting_sections"
            },
            "subcategory": {
              "enum": [
                "academy_community",
                "other_sports",
                "womens_football",
                "youth_football"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "non_sporting_activities"
            },
            "subcategory": {
              "enum": [
                "education"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "grants_donations"
            },
            "subcategory": {
              "enum": [
                "grants_donations"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "other_revenue"
            },
            "subcategory": {
              "enum": [
                "academy_community_expense",
                "admin_general_expense",
                "depreciation",
                "education_expense",
                "exceptional_items",
                "lump_football_operations_expense",
                "lump_rugby_operations_expense",
                "match_organisation_expense",
                "matchday_costs",
                "other_amortisation",
                "other_expenses",
                "other_income",
                "player_amortisation",
                "player_impairment",
                "player_registrations_amortisation",
                "squad_wages",
                "wages_squad",
                "youth_other_sports_expense"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "undisclosed"
            },
            "subcategory": {
              "enum": [
                "lump_football_operations",
                "lump_rugby_operations"
              ]
            }
          }
        }
      ]
    },
    "linea_gasto": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "category": {
          "enum": [
            "first_team_staff",
            "match_operations",
            "other_sporting_sections",
            "non_sporting_activities",
            "admin_general",
            "other_operating_expenses",
            "undisclosed",
            "player_registrations_amortisation",
            "player_registrations_impairment",
            "depreciation",
            "other_amortisation",
            "exceptional"
          ]
        },
        "subcategory": {
          "enum": [
            "academy_community",
            "academy_community_expense",
            "admin_general_expense",
            "broadcasting",
            "central_income",
            "commercial_activities",
            "competition_bonus",
            "depreciation",
            "education",
            "education_expense",
            "exceptional_items",
            "gate_receipts",
            "grants_donations",
            "lump_football_operations",
            "lump_football_operations_expense",
            "lump_rugby_operations",
            "lump_rugby_operations_expense",
            "match_organisation_expense",
            "matchday_competition",
            "matchday_costs",
            "member_dues",
            "other_amortisation",
            "other_expenses",
            "other_income",
            "other_sports",
            "player_amortisation",
            "player_impairment",
            "player_registrations_amortisation",
            "player_sales",
            "player_transfers",
            "season_tickets",
            "sponsorship_commercial",
            "squad_wages",
            "stadium_other",
            "wages_squad",
            "womens_football",
            "youth_football",
            "youth_other_sports_expense"
          ]
        },
        "amount": {
          "type": "number"
        },
        "disclosure": {
          "enum": [
            "aggregate",
            "aggregated",
            "aggregated_residual",
            "detailed",
            "estimated",
            "lump",
            "not_disclosed",
            "partial",
            "summary"
          ]
        },
        "items": {
          "$ref": "#/$defs/items"
        }
      },
      "required": [
        "label",
        "category",
        "subcategory",
        "amount"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "category": {
              "const": "first_team_staff"
            },
            "subcategory": {
              "enum": [
                "squad_wages",
                "wages_squad"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "match_operations"
            },
            "subcategory": {
              "enum": [
                "match_organisation_expense",
                "matchday_costs"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "other_sporting_sections"
            },
            "subcategory": {
              "enum": [
                "academy_community_expense",
                "youth_other_sports_expense"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "non_sporting_activities"
            },
            "subcategory": {
              "enum": [
                "education_expense"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "admin_general"
            },
            "subcategory": {
              "enum": [
                "admin_general_expense"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "other_operating_expenses"
            },
            "subcategory": {
              "enum": [
                "academy_community",
                "broadcasting",
                "central_income",
                "commercial_activities",
                "competition_bonus",
                "education",
                "gate_receipts",
                "grants_donations",
                "lump_football_operations",
                "lump_rugby_operations",
                "matchday_competition",
                "member_dues",
                "other_expenses",
                "other_income",
                "other_sports",
                "player_sales",
                "player_transfers",
                "season_tickets",
                "sponsorship_commercial",
                "stadium_other",
                "womens_football",
                "youth_football"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "undisclosed"
            },
            "subcategory": {
              "enum": [
                "lump_football_operations_expense",
                "lump_rugby_operations_expense"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "player_registrations_amortisation"
            },
            "subcategory": {
              "enum": [
                "player_amortisation",
                "player_registrations_amortisation"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "player_registrations_impairment"
            },
            "subcategory": {
              "enum": [
                "player_impairment"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "depreciation"
            },
            "subcategory": {
              "enum": [
                "depreciation"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "other_amortisation"
            },
            "subcategory": {
              "enum": [
                "other_amortisation"
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "exceptional"
            },
            "subcategory": {
              "enum": [
                "exceptional_items"
              ]
            }
          }
        }
      ]
    },
    "fx": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "rate": {
          "type": "number"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "anio": {
      "type": "object",
      "properties": {
        "fiscal_year": {
          "type": "integer"
        },
        "period_end": {
          "$ref": "#/$defs/fecha"
        },
        "period_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36,
          "not": {
            "const": 12
          },
          "description": "Meses del ejercicio, solo si no son 12 (sin el campo, 12). Un ejercicio de menos de 12 (tramo de transición por cambio de cierre) no entra al ranking por año, a la mediana de la liga ni a las variaciones interanuales."
        },
        "currency": {
          "$ref": "#/$defs/moneda"
        },
        "fx": {
          "$ref": "#/$defs/fx"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_type": {
          "type": "string"
        },
        "management_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revenue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/linea_ingreso"
          }
        },
        "expenses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/linea_gasto"
          }
        },
        "financial": {
          "type": "object",
          "properties": {
            "profit_on_player_sales": {
              "type": [
                "number",
                "null"
              ]
            },
            "asset_sales": {
              "type": [
                "number",
                "null"
              ]
            },
            "net_interest": {
              "type": [
                "number",
                "null"
              ]
            },
            "tax": {
              "type": [
                "number",
                "null"
              ]
            },
            "gross_debt": {
              "type": [
                "number",
                "null"
              ]
            },
            "cash": {
              "type": [
                "number",
                "null"
              ]
            },
            "staff_cost": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "official_totals": {
          "type": "object",
          "properties": {
            "revenue": {
              "type": [
                "number",
                "null"
              ]
            },
            "expenses": {
              "type": [
                "number",
                "null"
              ]
            },
            "net_result": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "adjustments": {
          "type": "object",
          "properties": {
            "extra_rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "amount": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "label",
                  "amount"
                ],
                "additionalProperties": false
              }
            },
            "no_breakdown": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "string"
                  },
                  "side": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "gross_margin",
                      "net_sales",
                      "cost_of_sales",
                      "other"
                    ]
                  }
                },
                "required": [
                  "line",
                  "side",
                  "amount",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "included_in": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "in": {
                        "type": "string"
                      },
                      "possible": {
                        "type": "boolean"
                      },
                      "by": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "in"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "fiscal_year",
        "period_end"
      ],
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "properties": {
        "currency": {
          "$ref": "#/$defs/moneda"
        },
        "fx": {
          "$ref": "#/$defs/fx"
        },
        "source_id": {
          "type": "string"
        },
        "revenue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/linea_ingreso"
          }
        },
        "expenses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/linea_gasto"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
